generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SavedCity {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  countryCode String
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())

  @@unique([name, countryCode])
}

model EcoAction {
  id          Int      @id @default(autoincrement())
  type        String
  description String
  amount      Float
  unit        String
  co2Saved    Float
  date        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}